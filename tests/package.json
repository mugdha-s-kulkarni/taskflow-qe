  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "typescript": "^5.5.3"
  }
}
